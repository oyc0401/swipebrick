{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:all*(svg|png|jpg|jpeg|webp|avif|ico|woff|woff2|ttf|otf|wav|mp3|ogg|mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "tsc -b && vite build"
}
